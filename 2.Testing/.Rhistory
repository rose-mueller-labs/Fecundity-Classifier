filenames <- list.files("/home/drosophila-lab/Documents/04-30-cap-800x800-sliced-Alexander/", pattern="*.jpg", full.names = T)
popVector <- c()
dayVector <- c()
eggVector <- c()
capVector <- c()
parVector <- c()
xVector <- c()
yVector <- c()
for (i in 1:length(filenames)) {
file <- filenames[i]
tempCount <- strsplit(file, "count")
tempCount <- strsplit(tempCount[[1]][1], "/eggs")
eggCount <- (tempCount[[1]][2])
temp <- readImage(filenames[i])
temp <- channel(temp, "gray")
if (mean(temp) > 0.3)
eggCount <- "N"
population <- strsplit(strsplit(file, 'count')[[1]][2], ' ')[[1]][1:2]
population <- paste(population[1], population[2])
day <- strsplit(file, ' ')[[1]][3]
cap_num <- strsplit(file, ' ')[[1]][4]
part <- strsplit(strsplit(file, ' ')[[1]][5], ".jpg")[[1]]
part <- strsplit(part, "t")[[1]][2]
part_number = as.integer(part)
if (part_number %% 10 == 0) {
x <- part_number /10 -1
y <- 9
} else {
x <- as.integer(floor(part_number / 10))
y <- (part_number %% 10)-1
}
popVector <- c(popVector, population)
dayVector <- c(dayVector, day)
eggVector <- c(eggVector, eggCount)
capVector <- c(capVector, cap_num)
parVector <- c(parVector, part)
xVector <- c(xVector, x)
yVector <- c(yVector, y)
}
